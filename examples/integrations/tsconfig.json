{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["esnext", "dom"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["bun"]
  },
  "include": [
    "tskm.config.ts",
    "src",
    "shared",
    "ai-sdk",
    "hono",
    "hono-openapi",
    "trpc",
    "tanstack",
    "tanstack-ai",
    "rhf",
    "elysia",
    "orpc",
    "orpc-openapi",
    "h3",
    "conform"
  ]
}
