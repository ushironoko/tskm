{
  "name": "@tskm/vite",
  "version": "0.0.4",
  "description": "Vite plugin that runs the tskm AOT type compiler",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ushironoko/tskm.git",
    "directory": "packages/vite"
  },
  "homepage": "https://github.com/ushironoko/tskm/tree/main/packages/vite#readme",
  "bugs": "https://github.com/ushironoko/tskm/issues",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "rolldown -c rolldown.config.ts",
    "attw": "attw --pack . --profile esm-only",
    "publint": "publint --strict"
  },
  "dependencies": {
    "@tskm/compiler": "workspace:*"
  },
  "peerDependencies": {
    "vite": ">=5"
  },
  "devDependencies": {
    "vite": "8.0.16"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
