{
  "name": "@tskm/vite",
  "version": "0.0.0",
  "description": "Vite plugin that runs the tskm AOT type compiler",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "rolldown -c rolldown.config.ts"
  },
  "dependencies": {
    "@tskm/compiler": "workspace:*"
  },
  "peerDependencies": {
    "vite": ">=5"
  },
  "devDependencies": {
    "vite": "8.0.16"
  },
  "publishConfig": {
    "access": "public"
  }
}
