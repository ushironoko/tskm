{
  "name": "@tskm/core",
  "version": "0.2.1",
  "description": "Standard Schema compliant, functional validation library with AOT type compilation",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ushironoko/tskm.git",
    "directory": "packages/tskm"
  },
  "homepage": "https://github.com/ushironoko/tskm/tree/main/packages/tskm#readme",
  "bugs": "https://github.com/ushironoko/tskm/issues",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "rolldown -c rolldown.config.ts",
    "attw": "attw --pack . --profile esm-only",
    "publint": "publint --strict",
    "test:mutation": "stryker run"
  },
  "devDependencies": {
    "@standard-schema/spec": "1.1.0",
    "valibot": "1.4.1"
  },
  "engines": {
    "node": ">=20",
    "bun": ">=1.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
