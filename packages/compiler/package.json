{
  "name": "@tskm/compiler",
  "version": "0.0.2",
  "description": "AOT schema-to-type compiler for tskm, powered by the tsgo (Corsa) checker API",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ushironoko/tskm.git",
    "directory": "packages/compiler"
  },
  "homepage": "https://github.com/ushironoko/tskm/tree/main/packages/compiler#readme",
  "bugs": "https://github.com/ushironoko/tskm/issues",
  "files": [
    "dist"
  ],
  "bin": {
    "tskm": "./dist/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "rolldown -c rolldown.config.ts",
    "attw": "attw --pack . --profile esm-only",
    "publint": "publint --strict"
  },
  "dependencies": {
    "@corsa-bind/napi": "0.35.0",
    "oxc-parser": "0.134.0"
  },
  "peerDependencies": {
    "@typescript/native-preview": ">=7.0.0-dev.20260601.1"
  },
  "devDependencies": {
    "@typescript/native-preview": "7.0.0-dev.20260601.1"
  },
  "engines": {
    "node": ">=22",
    "bun": ">=1.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
