{
  "name": "@tskm/compiler",
  "version": "0.4.1",
  "description": "AOT schema-to-type compiler for tskm, powered by the TypeScript typescript/sync checker API",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ushironoko/tskm.git",
    "directory": "packages/compiler"
  },
  "homepage": "https://github.com/ushironoko/tskm/tree/main/packages/compiler#readme",
  "bugs": "https://github.com/ushironoko/tskm/issues",
  "files": [
    "dist"
  ],
  "bin": {
    "tskm": "./dist/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "rolldown -c rolldown.config.ts",
    "attw": "attw --pack . --profile esm-only",
    "publint": "publint --strict",
    "test:mutation": "git clean -fX test && stryker run"
  },
  "dependencies": {
    "oxc-parser": "0.134.0"
  },
  "peerDependencies": {
    "typescript": ">=7.1.0-beta <8"
  },
  "devDependencies": {
    "typescript": "7.1.0-beta",
    "@valibot/to-json-schema": "1.7.0",
    "arktype": "2.2.0",
    "valibot": "1.4.1",
    "zod": "4.4.3"
  },
  "engines": {
    "node": ">=22",
    "bun": ">=1.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
